<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PdfReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_red</item>

        <!-- Status Bar Configuration -->
        <item name="android:statusBarColor">@color/bg_screen</item>
        <!-- In dark mode, set to false so battery, WiFi, and clock icons become WHITE -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar Configuration -->
        <item name="android:navigationBarColor">@color/card_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>