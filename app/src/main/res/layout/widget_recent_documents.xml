<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- Header: App Name & Icon -->
    <LinearLayout
        android:id="@+id/ll_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_doc_page_pdf"
            android:contentDescription="PDF Icon" />

        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="PDF Reader"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle / Document Prompt -->
    <TextView
        android:id="@+id/tv_widget_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_widget_header"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to resume reading or scan documents"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- 1-Tap Recent Documents -->
        <TextView
            android:id="@+id/btn_widget_recent"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill"
            android:gravity="center"
            android:text="📂 Recent Files"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 1-Tap Scan / Convert to PDF -->
        <TextView
            android:id="@+id/btn_widget_scan"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_done_button"
            android:gravity="center"
            android:text="📷 Image to PDF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
