<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Top Row: Close Button & AI Feature Icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Circular AI Badge -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_tool_circle"
                app:backgroundTint="#7C3AED">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tool_ai" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnAiClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_close_white"
                app:tint="#94A3B8" />
        </RelativeLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvAiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="AI Document Support"
            android:textColor="#0F172A"
            android:textSize="19sp" />

        <!-- Message requested by user -->
        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="This app now has AI support Click continue to use AI"
            android:textColor="#64748B"
            android:textSize="14.5sp" />

        <!-- Dedicated Native Ad Container for AI Feature Monetization -->
        <FrameLayout
            android:id="@+id/flAiNativeAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_language_card_unselected"
            android:minHeight="140dp">

            <!-- Default placeholder content before live native ad loads -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#7C3AED"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="SPONSORED"
                    android:textColor="@android:color/white"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AI Productivity Partner Features"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AdMob Native Ad Slot"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Continue Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAiContinue"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_done_button"
            android:fontFamily="sans-serif-bold"
            android:text="CONTINUE"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="#7C3AED" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
